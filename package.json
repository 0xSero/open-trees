{
  "name": "open-trees",
  "version": "2.0.0-beta.1",
  "description": "OpenCode plugin for safe git worktree workflows.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    "./server": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./tui": {
      "types": "./src/tui.ts",
      "import": "./src/tui.ts"
    },
    "./rpc": {
      "types": "./src/rpc.ts",
      "import": "./src/rpc.ts"
    }
  },
  "bin": {
    "open-trees": "./src/cli.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "bundle": "bun build src/index.ts src/server.ts src/cli.ts src/tui.ts src/rpc.ts --outdir dist --target bun --format esm --external @opencode/plugin --external @opencode/client && tsc --emitDeclarationOnly",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun test tests/e2e.test.ts"
  },
  "author": "0xSero",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xSero/open-trees.git"
  },
  "bugs": {
    "url": "https://github.com/0xSero/open-trees/issues"
  },
  "homepage": "https://github.com/0xSero/open-trees#readme",
  "keywords": [
    "opencode",
    "plugin",
    "git",
    "worktree"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode/client": "2.0.18",
    "@opencode/plugin": "2.0.18",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@bun-security-scanner/osv": "^1.0.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.7.3"
  }
}
